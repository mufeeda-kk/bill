# VINTAGE CLOTHING STORE - Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe to use in frontend with Row Level Security)
# NEVER put private admin keys or database passwords here!
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Shop Information Defaults
VITE_STORE_NAME="VINTAGE CLOTHING STORE"
VITE_STORE_TAGLINE="Exclusive Men's & Women's Fashion"
VITE_STORE_PHONE="919876543210"
VITE_STORE_ADDRESS="Shop #4, Market Road, Kerala, India"
VITE_STORE_UPI_ID="vintageclothing@upi"
VITE_CURRENCY_SYMBOL="₹"
VITE_TIMEZONE="Asia/Kolkata"

# Master Device Enrollment Passcode (used once to register the 3 shop phones)
VITE_ENROLLMENT_PASSCODE="VCS786"
